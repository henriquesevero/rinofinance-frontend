# Base URL of the RinoFinance API (rinofinance-api), no trailing slash.
# Local dev default matches the backend's default PORT (8080).
VITE_API_URL=http://localhost:8080

# Brandfetch Logo Link client ID (publishable, safe to expose client-side),
# used to fetch high-res brand icons by domain (e.g.
# cdn.brandfetch.io/netflix.com/icon?c=...). A default is baked into the code,
# so this is optional — set it only to override with your own client ID.
# Get yours at https://brandfetch.com — Brand APIs > Logo Link.
VITE_BRANDFETCH_CLIENT=
